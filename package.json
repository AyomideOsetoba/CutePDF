{
  "name": "cutepdf",
  "version": "1.0.0",
  "description": "Private, in-browser PDF toolkit for researchers: column-aware OCR, reader with highlights and notes, compress, merge, split and convert. Nothing is uploaded.",
  "author": "Ayomide Osetoba (https://github.com/AyomideOsetoba)",
  "homepage": "https://ayomideosetoba.github.io/CutePDF/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AyomideOsetoba/CutePDF.git"
  },
  "bugs": {
    "url": "https://github.com/AyomideOsetoba/CutePDF/issues"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "^9.15.3",
    "fflate": "^0.8.3",
    "lucide": "^1.72.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "dejavu-fonts-ttf": "^2.37.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}

  "bugs": {
    "url": "https://github.com/AyomideOsetoba/cutepdf/issues"
  },
  "homepage": "https://github.com/AyomideOsetoba/cutepdf#readme",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "^9.15.3",
    "fflate": "^0.8.3",
    "lucide": "^1.72.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "dejavu-fonts-ttf": "^2.37.3",
